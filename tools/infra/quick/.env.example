# Quick static-site deploy — configuration.
# The default 'local' backend works with no configuration at all.

# Backend selector: "local" (default) or "s3".
QUICK_DEPLOY_BACKEND=local

# Public URL domain. Sites resolve at https://<site_id>.<QUICK_BASE_DOMAIN>.
QUICK_BASE_DOMAIN=quick.internal

# --- local backend ---
# Directory the artifact tree is written under (served by the static server).
QUICK_LOCAL_ROOT=/srv/quick-sites

# --- s3 backend (AWS S3 or Cloudflare R2) ---
# Bucket name and S3-compatible endpoint. For R2 use the account endpoint, e.g.
#   https://<account_id>.r2.cloudflarestorage.com
QUICK_S3_BUCKET=
QUICK_S3_ENDPOINT=
QUICK_S3_REGION=auto
# Optional: override the returned URL base when serving is not subdomain-based.
QUICK_PUBLIC_BASE_URL=

# In production, S3/R2 credentials are injected by iron-proxy via an `aws_auth`
# secret (see pyproject.toml + references/architecture.md). Do NOT hardcode keys.

# --- ownership & serving ---
# Identity stamped onto each site's manifest on first deploy. Redeploys and
# deletes of an existing site must match its owner. Centaur injects the
# requester identity; set explicitly for local testing.
QUICK_REQUESTER=
# Set to "false" to disable the owner check (single-user dev clusters).
QUICK_OWNERSHIP_ENFORCE=true

# Static server (local backend): `python -m quick.server`
QUICK_SERVER_HOST=0.0.0.0
QUICK_SERVER_PORT=8943
