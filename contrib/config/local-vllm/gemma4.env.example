# Host-side environment for local Gemma 4 + vLLM.
# Copy to repo-root .local-vllm/.env or export in your shell before start scripts.
#
#   set -a && source contrib/config/local-vllm/gemma4.env.example && set +a
#   contrib/scripts/start-local-vllm-gemma4.sh

# MLX checkpoint (Apple Silicon). Override for CUDA: google/gemma-4-E4B-it
VLLM_MODEL=mlx-community/gemma-4-e2b-it-mxfp4

# OpenAI / Codex clients resolve this id (must match CODEX_MODEL in Centaur overlay).
VLLM_SERVED_MODEL_NAME=gemma

VLLM_PORT=8000
VLLM_HOST=0.0.0.0

# Centaur sandbox → host (kind / OrbStack). Used by test script and overlay.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=local
