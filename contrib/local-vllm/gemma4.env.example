# Local Gemma 4 + vLLM environment template for Centaur development.
# Copy to contrib/local-vllm/gemma4.env (gitignored) or export in your shell.
#
#   cp contrib/local-vllm/gemma4.env.example contrib/local-vllm/gemma4.env
#   set -a && source contrib/local-vllm/gemma4.env && set +a

# --- vLLM server (host) -------------------------------------------------------

# HuggingFace or mlx-community checkpoint id
VLLM_MODEL=mlx-community/gemma-4-e2b-it-mxfp4
# VLLM_MODEL=google/gemma-4-E4B-it

# OpenAI /v1/models id — must match CODEX_MODEL in the Helm overlay
VLLM_SERVED_MODEL_NAME=gemma

VLLM_PORT=8000
VLLM_HOST=0.0.0.0

# CUDA-only: passed to start-local-vllm-gemma4-cuda.sh
# VLLM_MAX_MODEL_LEN=8192
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_STRUCTURED_OUTPUT_DISABLE_ANY_WHITESPACE=1

# --- Centaur sandbox overlay (kind / OrbStack) --------------------------------

CODEX_USE_VLLM=1
VLLM_API_KEY=local
# kind: host.docker.internal — OrbStack: host.orb.internal
VLLM_BASE_URL=http://host.docker.internal:8000/v1
CODEX_MODEL=gemma
NO_PROXY=host.docker.internal,host.orb.internal,localhost,127.0.0.1

# Agent image must be built with Codex harness:
#   CENTAUR_SANDBOX_HARNESS=codex just build-one agent
#   kind load docker-image centaur-agent:latest --name centaur

# Helm overlay:
#   export CENTAUR_EXTRA_VALUES=contrib/chart/values.local-slack.example.yaml
